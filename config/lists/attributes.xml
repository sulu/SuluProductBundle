<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>attributes</key>

    <joins name="translation">
        <join>
            <entity-name>translation</entity-name>
            <field-name>Sulu\Product\Domain\Model\AttributeInterface.translations</field-name>
            <method>LEFT</method>
            <condition>translation.locale = :locale</condition>
        </join>
    </joins>

    <joins name="group">
        <join>
            <entity-name>Sulu\Product\Domain\Model\AttributeGroupInterface</entity-name>
            <field-name>Sulu\Product\Domain\Model\AttributeInterface.group</field-name>
            <method>LEFT</method>
        </join>
    </joins>

    <properties>
        <property name="id" translation="sulu_admin.id" visibility="no">
            <field-name>uuid</field-name>
            <entity-name>Sulu\Product\Domain\Model\AttributeInterface</entity-name>
        </property>

        <property name="name" translation="sulu_admin.name" visibility="always" searchability="yes">
            <field-name>name</field-name>
            <entity-name>translation</entity-name>
            <joins ref="translation"/>
        </property>

        <property name="key" translation="sulu_admin.key" visibility="yes" searchability="yes">
            <field-name>key</field-name>
            <entity-name>Sulu\Product\Domain\Model\AttributeInterface</entity-name>
        </property>

        <property name="type" translation="sulu_product.type" visibility="yes">
            <field-name>type</field-name>
            <entity-name>Sulu\Product\Domain\Model\AttributeInterface</entity-name>
        </property>

        <property name="position" translation="sulu_product.position" visibility="never" sortable="true">
            <field-name>position</field-name>
            <entity-name>Sulu\Product\Domain\Model\AttributeInterface</entity-name>
        </property>

        <property name="group" visibility="never">
            <field-name>uuid</field-name>
            <entity-name>Sulu\Product\Domain\Model\AttributeGroupInterface</entity-name>
            <joins ref="group"/>
        </property>
    </properties>
</list>
