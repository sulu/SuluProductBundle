<?xml version="1.0" ?>
<list xmlns="http://schemas.sulu.io/list-builder/list">
    <key>product_components</key>

    <joins name="dimensionContent">
        <join>
            <entity-name>dimensionContent</entity-name>
            <field-name>Sulu\Product\Domain\Model\ProductInterface.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>dimensionContent.locale = :locale AND dimensionContent.stage = 'draft' AND dimensionContent.version = 0</condition>
        </join>
    </joins>

    <joins name="unlocalizedDimensionContent">
        <join>
            <entity-name>unlocalizedDimensionContent</entity-name>
            <field-name>Sulu\Product\Domain\Model\ProductInterface.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>unlocalizedDimensionContent.locale IS NULL AND unlocalizedDimensionContent.stage = 'draft' AND unlocalizedDimensionContent.version = 0</condition>
        </join>
    </joins>

    <joins name="ghostDimensionContent" ref="unlocalizedDimensionContent">
        <join>
            <entity-name>ghostDimensionContent</entity-name>
            <field-name>Sulu\Product\Domain\Model\ProductInterface.dimensionContents</field-name>
            <method>LEFT</method>
            <condition>ghostDimensionContent.locale = unlocalizedDimensionContent.ghostLocale AND ghostDimensionContent.stage = 'draft' AND dimensionContent IS NULL AND ghostDimensionContent.version = 0</condition>
        </join>
    </joins>

    <joins name="productComponent">
        <join>
            <entity-name>productComponent</entity-name>
            <field-name>Sulu\Product\Domain\Model\ProductComponentInterface</field-name>
            <method>INNER</method>
            <condition>productComponent.component = Sulu\Product\Domain\Model\ProductInterface</condition>
        </join>
    </joins>

    <joins name="componentOwner" ref="productComponent">
        <join>
            <entity-name>componentOwner</entity-name>
            <field-name>productComponent.productDimensionContent</field-name>
            <method>INNER</method>
            <condition>componentOwner.locale IS NULL AND componentOwner.stage = 'draft' AND componentOwner.version = 0 AND IDENTITY(componentOwner.product) = :parentId</condition>
        </join>
    </joins>

    <properties>
        <property name="id" translation="sulu_admin.id" visibility="no">
            <field-name>uuid</field-name>
            <entity-name>Sulu\Product\Domain\Model\ProductInterface</entity-name>
        </property>

        <case-property name="name" translation="sulu_admin.name" visibility="always" searchability="yes">
            <field>
                <field-name>title</field-name>
                <entity-name>dimensionContent</entity-name>

                <joins ref="dimensionContent"/>
            </field>

            <field>
                <field-name>title</field-name>
                <entity-name>ghostDimensionContent</entity-name>

                <joins ref="ghostDimensionContent"/>
            </field>

            <transformer type="title"/>
        </case-property>

        <property name="code" translation="sulu_product.code" visibility="yes">
            <field-name>code</field-name>
            <entity-name>unlocalizedDimensionContent</entity-name>
            <joins ref="unlocalizedDimensionContent"/>
        </property>

        <property name="status" translation="sulu_product.status" visibility="yes">
            <field-name>status</field-name>
            <entity-name>unlocalizedDimensionContent</entity-name>
            <joins ref="unlocalizedDimensionContent"/>
            <transformer type="translation">
                <params>
                    <param name="prefix" value="sulu_product.product_status."/>
                </params>
            </transformer>
        </property>

        <property name="type" translation="sulu_product.product_type" visibility="yes">
            <field-name>type</field-name>
            <entity-name>Sulu\Product\Domain\Model\ProductInterface</entity-name>
            <transformer type="translation">
                <params>
                    <param name="prefix" value="sulu_product.product_type_"/>
                </params>
            </transformer>
        </property>

        <property name="componentPosition" visibility="never">
            <field-name>position</field-name>
            <entity-name>productComponent</entity-name>
            <joins ref="componentOwner"/>
        </property>

        <property name="ghostLocale" translation="sulu_admin.ghost_locale" visibility="never">
            <field-name>locale</field-name>
            <entity-name>ghostDimensionContent</entity-name>

            <joins ref="ghostDimensionContent"/>
        </property>
    </properties>
</list>
