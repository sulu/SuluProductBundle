<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass
        name="Sulu\Product\Domain\Model\ProductDimensionContent"
        table="pr_product_dimension_contents"
    >
        <unique-constraints>
            <unique-constraint name="uniq_pr_product_code" columns="code,stage,version"/>
        </unique-constraints>

        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="title" type="string" column="title" length="191" nullable="true"/>
        <field name="customizeWebspaceSettings" type="boolean" column="customizeWebspaceSettings" nullable="false"/>

        <many-to-one field="product" target-entity="Sulu\Product\Domain\Model\ProductInterface" inversed-by="dimensionContents">
            <join-columns>
                <join-column name="productUuid" referenced-column-name="uuid" on-delete="CASCADE" nullable="false"/>
            </join-columns>
        </many-to-one>

        <one-to-many
                field="additionalWebspaces"
                target-entity="Sulu\Product\Domain\Model\ProductDimensionContentAdditionalWebspace"
                mapped-by="productDimensionContent"
                orphan-removal="true"
        >
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

        <field name="code" type="string" length="255" nullable="true"/>
        <field name="externalIdentifier" type="string" length="255" nullable="true" column="external_identifier"/>
        <field name="status" type="string" length="255" nullable="false"/>
        <field name="detailsData" type="json" nullable="false" column="details_data"/>

        <many-to-one field="productFamily"
                     target-entity="Sulu\Product\Domain\Model\ProductFamilyInterface">
            <join-columns>
                <join-column name="idProductFamilies" referenced-column-name="id"
                             nullable="true" on-delete="RESTRICT"/>
            </join-columns>
        </many-to-one>

        <one-to-many field="attributes"
                     target-entity="Sulu\Product\Domain\Model\ProductAttributeValueInterface"
                     mapped-by="productDimensionContent"
                     orphan-removal="true">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

    </mapped-superclass>
</doctrine-mapping>
