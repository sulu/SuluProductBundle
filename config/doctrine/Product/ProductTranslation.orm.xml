<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity
        name="Sulu\Product\Domain\Model\ProductTranslation"
        table="pr_product_translations"
    >
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="locale" type="string" length="5" nullable="false"/>
        <field name="name" type="string" length="255" nullable="false"/>

        <many-to-one field="product"
                     target-entity="Sulu\Product\Domain\Model\ProductInterface"
                     inversed-by="translations">
            <join-column name="productUuid" referenced-column-name="uuid"
                         nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <indexes>
            <index name="IDX_pr_product_translations_locale" columns="locale"/>
        </indexes>
    </entity>
</doctrine-mapping>
