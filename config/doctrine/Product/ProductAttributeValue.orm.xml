<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Sulu\Product\Domain\Model\ProductAttributeValue" table="pr_product_attribute_values">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="attributeKey" column="attributeKey" type="string" length="255" nullable="false"/>
        <field name="attributeOptionKey" column="attributeOptionKey" type="string" length="255" nullable="true"/>
        <field name="number" type="float" nullable="true"/>
        <field name="text" type="string" length="255" nullable="true"/>
        <field name="json" type="json" nullable="true"/>

        <many-to-one field="product"
                     target-entity="Sulu\Product\Domain\Model\ProductInterface"
                     inversed-by="attributes">
            <join-column name="productUuid" referenced-column-name="uuid"
                         nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="attribute"
                     target-entity="Sulu\Product\Domain\Model\AttributeInterface">
            <join-column name="idAttributes" referenced-column-name="id"
                         nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="attributeOption"
                     target-entity="Sulu\Product\Domain\Model\AttributeOptionInterface">
            <join-column name="idAttributeOptions" referenced-column-name="id"
                         nullable="true" on-delete="SET NULL"/>
        </many-to-one>

        <many-to-one field="productFamilyAttribute"
                     target-entity="Sulu\Product\Domain\Model\ProductFamilyAttributeInterface">
            <join-column name="idProductFamilyAttributes" referenced-column-name="id"
                         nullable="true" on-delete="CASCADE"/>
        </many-to-one>

        <indexes>
            <index name="IDX_pr_product_attributes_key" columns="attributeKey"/>
            <index name="IDX_pr_product_attributes_opt_key" columns="attributeOptionKey"/>
        </indexes>
    </entity>
</doctrine-mapping>
