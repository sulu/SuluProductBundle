<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <mapped-superclass
        name="Sulu\Product\Domain\Model\Product"
        table="pr_products"
    >
        <id name="uuid" type="string" column="uuid" length="36">
            <generator strategy="NONE"/>
        </id>

        <field name="code" type="string" nullable="true" unique="true" length="255"/>

        <one-to-many field="dimensionContents" target-entity="Sulu\Product\Domain\Model\ProductDimensionContentInterface" mapped-by="product">
            <cascade>
                <cascade-persist/>
            </cascade>
        </one-to-many>

        <one-to-many field="translations" target-entity="Sulu\Product\Domain\Model\ProductTranslationInterface" mapped-by="product">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

    </mapped-superclass>
</doctrine-mapping>
