<?xml version="1.0" encoding="utf-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Sulu\Product\Domain\Model\AttributeGroupAttribute" table="pr_attribute_group_attributes">
        <id name="id" type="integer" column="id">
            <generator strategy="AUTO"/>
        </id>

        <field name="position" type="integer" nullable="false">
            <options><option name="default">0</option></options>
        </field>

        <many-to-one field="attributeGroup"
                     target-entity="Sulu\Product\Domain\Model\AttributeGroupInterface"
                     inversed-by="groupAttributes">
            <join-column name="idAttributeGroups" referenced-column-name="id"
                         nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <many-to-one field="attribute"
                     target-entity="Sulu\Product\Domain\Model\AttributeInterface">
            <join-column name="idAttributes" referenced-column-name="id"
                         nullable="false" on-delete="CASCADE"/>
        </many-to-one>

        <unique-constraints>
            <unique-constraint columns="idAttributeGroups,idAttributes"
                               name="UNIQ_pr_attribute_group_attributes_group_attr"/>
        </unique-constraints>
    </entity>
</doctrine-mapping>
