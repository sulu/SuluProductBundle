<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd">

    <key>attribute_details</key>

    <properties>
        <property name="name" type="text_line" mandatory="true">
            <meta>
                <title>sulu_admin.name</title>
            </meta>

            <params>
                <param name="headline" value="true"/>
            </params>
        </property>

        <property name="externalIdentifier" type="text_line"
                  visibleCondition="!!externalIdentifier"
                  disabledCondition="true">
            <meta>
                <title>sulu_product.external_identifier</title>
            </meta>
        </property>

        <property name="key" type="text_line" mandatory="true" colspan="6" disabledCondition="!!id">
            <meta>
                <title>sulu_admin.key</title>
            </meta>
        </property>

        <property name="type" type="single_select" mandatory="true" colspan="4" disabledCondition="!!id">
            <meta>
                <title>sulu_product.type</title>
            </meta>
            <params>
                <param name="values" type="expression"
                    value="service('sulu_product.attribute_type_select_service').getValues(locale)"/>
            </params>
        </property>

        <property name="localized" type="checkbox" colspan="2"
                  visibleCondition='type == "text" || type == "json"'
                  disabledCondition="!!id">
            <meta>
                <title>sulu_product.localized</title>
            </meta>
        </property>

        <property name="group" type="single_attribute_group_selection" mandatory="true" colspan="9">
            <meta>
                <title>sulu_product.attribute_group</title>
            </meta>
        </property>

        <property name="position" type="number" colspan="3">
            <meta>
                <title>sulu_product.position</title>
            </meta>
        </property>

        <property name="measurementFamily" type="single_measurement_family_selection" colspan="6"
                  visibleCondition='type == "number"'>
            <meta>
                <title>sulu_product.measurement_family</title>
            </meta>
        </property>

        <property name="config/unit" type="single_measurement_unit_selection" colspan="6"
                  visibleCondition='type == "number"'
                  disabledCondition="!measurementFamily">
            <meta>
                <title>sulu_product.unit</title>
            </meta>
            <params>
                <param name="resource_store_properties_to_request" type="collection">
                    <param name="measurementFamily" value="measurementFamily"/>
                </param>
            </params>
        </property>

        <property name="config/min" type="number" colspan="6"
                  visibleCondition='type == "number"'>
            <meta>
                <title>sulu_product.min</title>
            </meta>
        </property>

        <property name="config/max" type="number" colspan="6"
                  visibleCondition='type == "number"'>
            <meta>
                <title>sulu_product.max</title>
            </meta>
        </property>

        <property name="description" type="text_editor">
            <meta>
                <title>sulu_admin.description</title>
            </meta>
        </property>

        <block name="options" default-type="option" colspan="12" visibleCondition='type == "options"'>
            <meta>
                <title>sulu_product.options</title>
            </meta>
            <types>
                <type name="option">
                    <meta>
                        <title>sulu_product.option</title>
                    </meta>
                    <properties>
                        <property name="key" type="text_line" mandatory="true" colspan="6">
                            <meta>
                                <title>sulu_admin.key</title>
                            </meta>
                        </property>
                        <property name="name" type="text_line" mandatory="true" colspan="6">
                            <meta>
                                <title>sulu_admin.name</title>
                            </meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>
    </properties>
</form>
