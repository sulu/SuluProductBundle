<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd">

    <key>attribute_group_details</key>

    <properties>
        <property name="name" type="text_line" mandatory="true">
            <meta>
                <title>sulu_admin.name</title>
            </meta>

            <params>
                <param name="headline" value="true"/>
            </params>
        </property>

        <property name="externalIdentifier" type="text_line"
                  visibleCondition="!!externalIdentifier"
                  disabledCondition="true">
            <meta>
                <title>sulu_product.external_identifier</title>
            </meta>
        </property>

        <property name="description" type="text_editor">
            <meta>
                <title>sulu_admin.description</title>
            </meta>
        </property>

        <block name="attributes" default-type="attribute_item" colspan="12">
            <meta>
                <title>sulu_product.attributes</title>
            </meta>
            <types>
                <type name="attribute_item">
                    <meta>
                        <title>sulu_product.attribute</title>
                    </meta>
                    <properties>
                        <property name="attribute" type="single_attribute_selection" mandatory="true" colspan="12">
                            <meta>
                                <title>sulu_product.attribute</title>
                            </meta>
                        </property>
                    </properties>
                </type>
            </types>
        </block>
    </properties>
</form>
