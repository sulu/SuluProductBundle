{
    "name": "sulu/product-bundle",
    "type": "symfony-bundle",
    "description": "Sulu Product Bundle",
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sulu/SuluMcpBundle.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-ctype": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "cmsig/seal": "^0.12",
        "doctrine/collections": "^1.6 || ^2.0",
        "doctrine/dbal": "^3.9 || ^4.0",
        "doctrine/orm": "^2.17.3 || ^3.3",
        "sulu/messenger": "^1.0",
        "sulu/sulu": "^3.1@dev",
        "symfony/config": "^6.4 || ^7.1 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.1 || ^8.0",
        "symfony/event-dispatcher": "^6.4 || ^7.1 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.1 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.1 || ^8.0",
        "symfony/messenger": "^6.4 || ^7.1 || ^8.0",
        "symfony/routing": "^6.4 || ^7.1 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.1 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.1 || ^8.0",
        "symfony/service-contracts": "^3.0",
        "symfony/translation-contracts": "^3.0",
        "symfony/uid": "^6.4 || ^7.1 || ^8.0",
        "twig/twig": "^3.0",
        "webmozart/assert": "^1.0 || ^2.0"
    },
    "conflict": {
        "doctrine/orm": "3.7.x-dev",
        "sulu/mcp-bundle": "<=1.0.0-RC3 || 1.0.x-dev"
    },
    "require-dev": {
        "ext-filter": "*",
        "handcraftedinthealps/code-coverage-checker": "^0.2.1",
        "jangregor/phpstan-prophecy": "^2.0",
        "league/oauth2-server-bundle": "^1.2",
        "php-cs-fixer/shim": "^3.14",
        "phpspec/prophecy": "^1.0",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "spaze/phpstan-disallowed-calls": "^4.7",
        "sulu/mcp-bundle": "dev-remove-product-tools",
        "symfony/ai-agent": "^0.14",
        "symfony/browser-kit": "^6.4 || ^7.1 || ^8.0",
        "symfony/console": "^6.4 || ^7.1 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.1 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.1 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.1 || ^8.0",
        "symfony/mcp-bundle": "^0.13",
        "cmsig/seal-memory-adapter": "^0.12.10"
    },
    "suggest": {
        "sulu/mcp-bundle": "Enables the sulu_product_* MCP tools and the sulu_content_search / unified content tools product hook.",
        "symfony/ai-agent": "To expose read-only product/attribute tools to a Symfony AI agent."
    },
    "autoload": {
        "psr-4": {
            "Sulu\\Product\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sulu\\Product\\Tests\\": "tests/",
            "Sulu\\Content\\Tests\\": "vendor/sulu/sulu/packages/content/tests/"
        }
    },
    "scripts": {
        "bootstrap-test-environment": [
            "@php tests/Application/bin/console.php doctrine:database:drop --if-exists --force --env test",
            "@php tests/Application/bin/console.php doctrine:database:create --env test",
            "@php tests/Application/bin/console.php doctrine:schema:update --force --complete --env test"
        ],
        "test": "@php vendor/bin/phpunit",
        "test-with-coverage": "@php vendor/bin/phpunit --coverage-php tests/reports/coverage.php --coverage-html tests/reports/html --log-junit tests/reports/junit.xml",
        "check-coverage": "@php vendor/bin/code-coverage-checker \"tests/reports/coverage.php\" \"line\" \"100.00\" \"src\"",
        "lint": [
            "@lint-composer",
            "@lint-composer-dependencies",
            "@lint-doctrine",
            "@lint-container",
            "@lint-yaml",
            "@lint-rector",
            "@php-cs",
            "@phpstan"
        ],
        "fix": [
            "@rector",
            "@php-cs-fix"
        ],
        "phpstan": [
            "@php tests/Application/bin/console.php cache:warmup --env test",
            "@php vendor/bin/phpstan analyse"
        ],
        "php-cs": "@php vendor/bin/php-cs-fixer fix --verbose --diff --dry-run",
        "php-cs-fix": "@php vendor/bin/php-cs-fixer fix",
        "lint-rector": [
            "Composer\\Config::disableProcessTimeout",
            "@php tests/Application/bin/console.php cache:warmup --env test",
            "@php vendor/bin/rector process --dry-run"
        ],
        "rector": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/rector process"
        ],
        "lint-composer": "@composer validate --strict",
        "lint-composer-dependencies": "@php vendor/bin/composer-dependency-analyser --show-all-usages",
        "lint-doctrine": "@php tests/Application/bin/console.php doctrine:schema:validate --skip-sync --env test",
        "lint-container": "@php tests/Application/bin/console.php lint:container --env test",
        "lint-yaml": "@php tests/Application/bin/console.php lint:yaml tests/Application/config --env test"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
