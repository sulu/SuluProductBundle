{% extends 'views/base.html.twig' %}

{% block content %}
    <p>query={{ query }}</p>
    <p>total={{ total }}</p>
    <p>page={{ page }}</p>
    <p>limit={{ limit }}</p>
    <p>variantQueryParameter={{ variantQueryParameter }}</p>
    <p>facets={{ facets|json_encode }}</p>
    <ul>
    {% for hit in hits %}
        <li>{{ hit.title }}</li>
    {% endfor %}
    </ul>
{% endblock %}
